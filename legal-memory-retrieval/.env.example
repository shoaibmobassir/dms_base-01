DATABASE_URL=postgresql://legal:legal@localhost:55432/legal_memory
CORPUS_DIR=../dummy-firm/data
EMBEDDING_DIM=384
RETRIEVAL_CHANNELS=keyword,metadata,vector,graph
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=100
RERANK_CE_WEIGHT=0.55
GROQ_API_KEY=
GEMINI_API_KEY=
ANSWER_PROVIDER=auto
GROQ_MODEL=llama3-70b-8192
GEMINI_MODEL=gemini-1.5-flash
REDIS_URL=redis://localhost:6380
CACHE_TTL_SECONDS=300
# ── Deployment ──────────────────────────────────────────────────────────────
# ENV=production refuses to start unless the settings below are production-safe
# (auth on, explicit CORS origins, non-default secrets, explicit ingest roots).
ENV=development
# false trusts the X-Member-Id header (dev only); true requires X-Api-Key.
# Issue keys with: python scripts/issue_keys.py
AUTH_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Server directories bulk ingest jobs may read (comma list). Empty = workspace (dev).
INGEST_ALLOWED_ROOTS=
# Projects/activity APIs have no UI; enable only if a client still needs them.
ENABLE_LEGACY_PROJECTS=false
RATE_LIMIT_ASK_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=20

# Amazon Bedrock AI layer (Ask / chat / experimental embeddings)
# export AWS_BEARER_TOKEN_BEDROCK=...  (do NOT commit the token)
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_EMBEDDING_REGION=us-east-2
BEDROCK_MODEL=zai.glm-5
# Production retrieval stays on MiniLM 384-d. Bedrock embeddings are for
# experimentation only until a re-embed + schema migration lands.
EMBEDDING_PROVIDER=minilm
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
# Prefer Bedrock when ANSWER_PROVIDER=auto and the bearer token is set
DEFAULT_LLM_PROVIDER=bedrock

# Universal source sync (Phase 0 — FakeConnector; Drive/Graph later)
SOURCES_SYNC_ENABLED=false
SOURCES_QUEUE_INLINE=true
SOURCES_TOKEN_ENCRYPTION_SECRET=firmos-dev-sources-token-encryption-secret-32b
